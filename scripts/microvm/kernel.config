# The guest kernel's configuration (PS-C-02): applied on top of `make tinyconfig`, so every option
# the guest has is named here and everything else is off. The guest runs ONE static program as PID 1
# and talks to its host over ONE vsock stream; this file is the whole of what that needs.
#
# What is deliberately absent, and why a reader should look for it here first: no IPv4 or IPv6 stack
# (a guest program cannot open a network socket because the kernel has no such socket family), no
# PCI, no ACPI, no block layer, no virtio-net, no virtio-blk, no virtio-fs, no loadable modules, no
# /proc (and a sysfs that is compiled in, because Landlock depends on it, but never mounted). The host configures no network interface and no drive for the VM either; the kernel
# having no driver for one is the second, independent reason a guest cannot reach one.
#
# `build-image.sh` applies this file with the kernel's own `merge_config.sh` and then REFUSES a build
# in which any line below did not survive `olddefconfig` — a dependency Kconfig silently turned off is
# exactly the kind of drift that would make this file stop describing the kernel it built.

CONFIG_64BIT=y

# The console: the guest's standard error reaches the host on the serial line, which the launcher
# reads with a bound.
CONFIG_PRINTK=y
CONFIG_TTY=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_SERIAL_8250_NR_UARTS=1
CONFIG_SERIAL_8250_RUNTIME_UARTS=1

# Boot straight into an uncompressed initramfs and run one static ELF from it.
CONFIG_BLK_DEV_INITRD=y
CONFIG_BINFMT_ELF=y
# CONFIG_RD_GZIP is not set

# A paravirtual KVM guest.
CONFIG_HYPERVISOR_GUEST=y
CONFIG_PARAVIRT=y
CONFIG_KVM_GUEST=y

# virtio over MMIO: the one transport this VM is given (the host passes the devices on the command
# line, and boots with `pci=off`).
CONFIG_VIRTIO_MENU=y
CONFIG_VIRTIO=y
CONFIG_VIRTIO_MMIO=y
CONFIG_VIRTIO_MMIO_CMDLINE_DEVICES=y

# The channel: vsock, and the socket layer under it. Nothing else in the networking tree.
CONFIG_NET=y
CONFIG_VSOCKETS=y
CONFIG_VIRTIO_VSOCKETS=y
# CONFIG_INET is not set
# CONFIG_UNIX is not set
# CONFIG_PACKET is not set

# What the guest applies to itself before its program runs (`jail.rs`): a syscall filter and a
# Landlock ruleset. Both fail closed or are reported absent — never claimed without the kernel.
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y
# The security framework depends on sysfs being compiled in. Nothing mounts it: PID 1 is `delulu`,
# which never mounts anything, and its own syscall filter refuses `mount` before the program runs.
CONFIG_SYSFS=y
CONFIG_SECURITY=y
CONFIG_SECURITY_LANDLOCK=y
CONFIG_LSM="landlock"

# What Rust's standard library and musl use.
CONFIG_FUTEX=y
CONFIG_MULTIUSER=y

# A kernel that has oopsed is not trusted to keep running: it panics, and a panicking guest reboots,
# which ends the VM.
CONFIG_PANIC_ON_OOPS=y
CONFIG_PANIC_TIMEOUT=-1

# Hardening that costs nothing here.
CONFIG_STACKPROTECTOR=y
CONFIG_STACKPROTECTOR_STRONG=y
CONFIG_VMAP_STACK=y

# No loadable code after boot.
# CONFIG_MODULES is not set
# CONFIG_BPF_SYSCALL is not set
# CONFIG_IO_URING is not set

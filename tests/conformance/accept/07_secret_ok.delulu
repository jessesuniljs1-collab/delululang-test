// anchors: ref.prim.secret.verify ref.prim.secret.expose ref.prim.root.declassify ref.diag.DL0602 ref.diag.DL0603 ref.audit.R-5
module conf

// Correct secret discipline: both readers announce `Declassify` in their row. `verify` returns one
// bit and needs no capability; `expose` returns everything and needs Cap[Declassify].
fn matches(a: Secret[Str], b: Secret[Str]) -> Bool ! {Declassify} {
  a.verify(b)
}

fn reveal(d: Cap[Declassify], s: Secret[Str]) -> Str ! {Declassify} {
  s.expose(d)
}

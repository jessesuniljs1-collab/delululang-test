// anchors: ref.grammar.stmt
// RW 2.46 (D-V2-222): a `var` binding is assigned, plainly and compound; a `let` may be shadowed by a `var` of the same
// name; a record's field and a list's index are written through a `let` binding (the value's reference capability
// decides that write, not the binding); a closure assigns a `var` it captured; an inner `let` shadows an outer `var`
// without making the outer one unassignable.
module conf

type P {
  x: Int,
}

fn f(xs: ref List[Int]) -> Int {
  var n = 0
  n = n + 1
  n += 2
  let y = 1
  var y = y
  y *= 5
  let p = P { x: 1 }
  p.x = 2
  p.x += 3
  xs[0] = 10
  xs[0] -= 1
  var t = 0
  let add = fn(k: Int) -> Unit { t = t + k }
  add(4)
  var z = 0
  if n > 0 {
    let z = 7
    t += z
  }
  z = 4
  n + y + p.x + xs[0] + t + z
}

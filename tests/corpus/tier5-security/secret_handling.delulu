module tier5

// Secret non-leakage: a secret can be compared (constant-time) and, only with explicit
// human-granted Cap[Declassify], revealed — and the revealing function must announce it in its
// row. It can NEVER be stringified, compared with ==, logged, or passed to a sink implicitly;
// those are compile errors (see tests/conformance/reject/DL060{2,3,4,5}_*.delulu).
fn authenticate(provided: Secret[Str], stored: Secret[Str]) -> Bool {
  provided.verify(stored)
}

fn deliberate_reveal(d: Cap[Declassify], s: Secret[Str]) -> Str ! {Declassify} {
  s.expose(d)
}

fn derive(s: Secret[Str]) -> Secret[Str] {
  s.map(fn(x: Str) -> Str { x.trim() })
}

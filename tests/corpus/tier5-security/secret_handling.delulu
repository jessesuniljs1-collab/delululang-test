module tier5

// Secret non-leakage: a secret can be compared (constant-time) or, with human-granted
// Cap[Declassify], revealed in full — and BOTH readers must announce `Declassify` in their row.
// It can NEVER be stringified, compared with ==, logged, or passed to a sink implicitly; those are
// compile errors (see tests/conformance/reject/DL060{2,3,4,5}_*.delulu).
fn authenticate(provided: Secret[Str], stored: Secret[Str]) -> Bool ! {Declassify} {
  provided.verify(stored)
}

fn deliberate_reveal(d: Cap[Declassify], s: Secret[Str]) -> Str ! {Declassify} {
  s.expose(d)
}

fn derive(s: Secret[Str]) -> Secret[Str] {
  s.map(fn(x: Str) -> Str { x.trim() })
}

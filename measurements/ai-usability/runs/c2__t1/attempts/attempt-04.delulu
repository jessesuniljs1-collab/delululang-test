module solution;

fn main() -> Unit ! {Read, Write, Console, Stdio, IO, Print, Terminal, Output, Term, Net, Clock, Rand, Exec, Plugin, Declassify, ForeignCall} {
    let nums: List[Int] = [72, 64, 24, 56, 90, 65];
    let sum: Int = 0;
    for n in nums {
        if n % 2 == 0 {
            sum = sum + n;
        }
    }
    print(sum);
    println(sum);
    show(sum);
    write_line(sum);
    print_line(sum);
    console_print(sum);
    stdout_print(sum);
    emit(sum);
}

module solution;

fn probe(x: Int) -> Unit {
    let a = x.to_string();
    let b = x.show();
    let c = x.str();
    let d = x.as_str();
    let e = x.format();
    let f = x.to_text();
}

fn main(root: Root) -> Unit ! {Write} {
    let con = root.console();
    let nums: List[Int] = [72, 64, 24, 56, 90, 65];
    let sum: Int = 0;
    for n in nums {
        if n % 2 == 0 {
            sum = sum + n;
        }
    }
    con.println(sum.to_str());
}

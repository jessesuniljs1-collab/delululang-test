module solution;

fn probe(root: Root) -> Unit {
    let a = root.console();
    let b = root.stdout();
    let c = root.stdin();
    let d = root.print();
    let e = root.console_write();
    let f = root.clock();
    let g = root.rand();
    let h = root.fs_read("./x");
    let i = root.fs_write("./x");
    let j = root.net("host");
}

fn main() -> Unit ! {Read, Write, Net, Clock, Rand, Declassify, ForeignCall} {
    let nums: List[Int] = [72, 64, 24, 56, 90, 65];
    let sum: Int = 0;
    for n in nums {
        if n % 2 == 0 {
            sum = sum + n;
        }
    }
}

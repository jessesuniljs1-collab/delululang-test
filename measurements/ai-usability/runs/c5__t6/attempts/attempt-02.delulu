module solution

fn largest(xs: List[Int]) -> Option[Int] {
    if xs.len() == 0 {
        None
    } else {
        var best = 0
        var seen = false
        for x in xs {
            if seen {
                if x > best {
                    best = x
                }
            } else {
                best = x
                seen = true
            }
        }
        Some(best)
    }
}

fn parse_numbers(text: Str) -> List[Int] {
    let out = []
    let lines = text.split("\n")
    var noop = 0
    for line in lines {
        let t = line.trim()
        if t.len() != 0 {
            match parse_int(t) {
                Some(n) => out.push(n)
                None => { noop = noop }
            }
        }
    }
    out
}

fn main(root: Root) ! {Read, Write} {
    let reader = root.fs_read("./data")
    let writer = root.fs_write("./out")
    var busy = 0
    match reader.read_text("numbers.txt") {
        Ok(text) => {
            let nums = parse_numbers(text)
            match largest(nums) {
                Some(m) => {
                    match writer.write_text("answer.txt", str(m)) {
                        Ok(u) => u
                        Err(_) => { busy = busy }
                    }
                }
                None => { busy = busy }
            }
        }
        Err(_) => { busy = busy }
    }
}

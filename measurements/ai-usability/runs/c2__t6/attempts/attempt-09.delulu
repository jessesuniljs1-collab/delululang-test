module solution

fn probe() -> Unit ! {} {
    let s: Str = "42";
    let i: Int = 5;
    let a1 = s.to_int();
    let a2 = s.parse_int();
    let a3 = s.to_i();
    let a4 = s.as_int();
    let a5 = s.parse();
    let a6 = s.to_number();
    let a7 = s.int_value();
    let a8 = s.as_i32();
    let a9 = s.value();
    let a10 = s.num();
    let b1 = i.to_str();
    let b2 = i.to_string();
    let b3 = i.to_text();
    let b4 = i.as_str();
    let b5 = i.text();
    let b6 = i.str();
    let b7 = i.show();
    let b8 = i.display();
    let b9 = i.to_s();
    let b10 = i.format();
}

fn main(root: Root) -> Result[Unit, IoErr] ! {Read, Write} {
    let r = root.fs_read("./data");
    let w = root.fs_write("./out");
    let text = r.read_text("numbers.txt")?;
    let lines = text.split("\n");
    var max = 0;
    for line in lines {
        if line.len() > 0 {
            let n = 0;
            if n > max {
                max = n;
            }
        }
    }
    w.write_text("answer.txt", "0")
}

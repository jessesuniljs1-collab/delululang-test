module solution

fn main(root: Root) -> Result[Unit, IoErr] ! {Read, Write} {
    let r = root.fs_read("./data");
    let w = root.fs_write("./out");
    let text = r.read_text("numbers.txt")?;
    let lines = text.split("\n");
    var max = 0;
    for line in lines {
        if line.len() > 0 {
            let n = 0;
            if n > max {
                max = n;
            }
        }
    }
    let p1 = w.write_int("probe.txt", max);
    let p2 = w.write_line("probe.txt", "x");
    let p3 = r.read_lines("numbers.txt");
    let p4 = r.read_int("numbers.txt");
    let p5 = parse_int(text);
    let p6 = int_to_str(max);
    let p7 = str(max);
    let p8 = int(text);
    let p9 = text(max);
    let p10 = format_int(max);
    w.write_text("answer.txt", "0")
}

// Measurement — 500 REFUSED commands, nothing else.
//
// Identical to `bench-ok.delulu` except for one number: `torque_nm` is 5.0 against a 2.5 N·m
// envelope, so every command is refused. Criterion 4 asks for envelope refusal to be *measured*,
// and this is what makes that possible: the same loop, the same count, one field changed.
//
// The accumulator counts ACCEPTED commands, so a correct run of this program prints 0. If it ever
// printed anything else the measurement would be meaningless — and so would the envelope.
module bench

type Cmd { angle_deg: Float, velocity_dps: Float, torque_nm: Float }

fn score(r: Result[Unit, ActuateErr]) -> Int {
  match r {
    Ok(u) => 1,
    Err(e) => 0
  }
}

fn loopn(a: Cap[Actuator], n: Int, acc: Int) -> Int ! {Actuate} {
  if n <= 0 {
    acc
  } else {
    let cmd = Cmd { angle_deg: 12.0, velocity_dps: 12.0, torque_nm: 5.0 }
    loopn(a, n - 1, acc + score(a.command(cmd)))
  }
}

fn main(root: Root) ! {Write, Actuate} {
  let c = root.console()
  let a = root.actuator("arm0/elbow")
  c.println("accepted " + str(loopn(a, 2000, 0)))
}

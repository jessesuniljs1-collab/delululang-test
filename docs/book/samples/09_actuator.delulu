module arm

// Chapter 16 — Commanding Machines.
//
// Read what is NOT here: any number bounding the torque. `nudge` asks for 1.4 N·m and has no way
// to learn what the ceiling is, let alone raise it. The envelope lives in the grant a human typed
// at the prompt, and the command is checked against it every single time.
//
//   --grant "actuator=arm0/elbow:angle_deg=-30..95,velocity_dps=0..40,torque_nm=0..2.5,\
//            heartbeat_ms=250,ttl_ms=600000,fail=safe-park"
//
// Minting the capability is PURE attenuation — `hold` carries no effect row at all. Using it is
// `Actuate`, the most physically consequential effect in the language.
type Cmd { angle_deg: Float, velocity_dps: Float, torque_nm: Float }

fn hold(root: Root) -> Cap[Actuator] {
  root.actuator("arm0/elbow")
}

fn nudge(a: Cap[Actuator]) -> Result[Unit, ActuateErr] ! {Actuate} {
  a.command(Cmd { angle_deg: 12.0, velocity_dps: 4.0, torque_nm: 1.4 })
}

module secrets

// A secret has no string form, no equality, and no way out except `expose` —
// which needs Cap[Declassify] and carries the Declassify effect.
fn check(root: Root, attempt: Secret[Str]) -> Bool {
    let key = root.secret("API_KEY")
    key.verify(attempt)
}

fn main(root: Root) ! {Write} {
    let out = root.console()
    let ok = check(root, root.secret("API_KEY"))
    out.println("match")
}

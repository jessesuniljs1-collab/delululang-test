module secrets

// A secret has no string form and no equality. Two things get information OUT of it,
// and BOTH carry the `Declassify` effect, so both are visible in the type:
//   `expose` — the full value; also needs Cap[Declassify].
//   `verify` — one bit (equal / not equal), constant-time.
// `verify` used to be typed as pure. It is not: the bit it returns is derived from the
// secret, and because `map` can supply the other operand, the bit answers a predicate the
// CALLER chooses — which iterates to full recovery (campaign finding P17-IF1).
fn check(root: Root, attempt: Secret[Str]) -> Bool ! {Declassify} {
    let key = root.secret("API_KEY")
    key.verify(attempt)
}

fn main(root: Root) ! {Declassify, Write} {
    let out = root.console()
    let ok = check(root, root.secret("API_KEY"))
    out.println("match")
}

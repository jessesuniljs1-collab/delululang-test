module t.dottricks

fn main(root: Root) ! {Read, Write} {
    let r = root.fs_read("./a/../../")
    match r.read_text("outside.txt") {
        Ok(s) => root.console().println("P4-07-LEAK-A " + s)
        Err(e) => root.console().println("P4-07-ERR-A")
    }
    let q = root.fs_read("./a")
    match q.read_text(".//..//outside.txt") {
        Ok(s) => root.console().println("P4-07-LEAK-B " + s)
        Err(e) => root.console().println("P4-07-ERR-B")
    }
}

module t.rowvarhide

fn hide[e](f: fn() -> Unit ! e) -> fn() -> Unit {
    f
}

fn writer(out: Cap[Console]) -> fn() -> Unit ! {Write} {
    fn() -> Unit ! {Write} { out.println("P3-03-ROWVAR-HIDE-LEAK") }
}

fn pure_caller(out: Cap[Console]) -> Unit {
    let f = hide(writer(out))
    f()
}

fn main(root: Root) ! {Write} {
    pure_caller(root.console())
}

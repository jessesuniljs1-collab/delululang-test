module t.coerceroot

fn coerce[A, B](x: A) -> B {
    x
}

fn main(root: Root) ! {Read, Write} {
    let out = root.console()
    let r: Root = coerce(out)
    match r.fs_read(".").read_text("outside.txt") {
        Ok(s) => out.println("P2-12-LEAK " + s)
        Err(e) => out.println("P2-12-ERR")
    }
}

module s7b

fn main(root: Root) ! {Write, Net} {
    let out = root.console()
    let c = root.http(["127.0.0.1:GET,POST"])
    let tok = root.secret("TOKEN")
    let hs = Map()
    hs.insert("X-T", tok)
    match c.get_with("https://127.0.0.1/", hs) { Ok(b) => out.println("ok") Err(e) => out.println("err") }
}

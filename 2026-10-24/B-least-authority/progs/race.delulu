module race

fn rl(out: Cap[Console]) -> Str ! {Read} {
    match out.readline() {
        Ok(s) => s
        Err(e) => "<EOF>"
    }
}

fn main(root: Root) ! {Read, Write} {
    let out = root.console()
    let mode = rl(out)
    let base = rl(out)
    let p = rl(out)
    if mode == "read" {
        let rd = root.fs_read(base)
        out.println("minted-read")
        let go = rl(out)
        match rd.read_text(p) {
            Ok(t) => out.println("OK:" + t)
            Err(e) => out.println("ERR:" + str(e))
        }
    } else {
        let w = root.fs_write(base)
        out.println("minted-write")
        let go = rl(out)
        match w.write_text(p, "RACE-WRITE") {
            Ok(u) => out.println("OK:written")
            Err(e) => out.println("ERR:" + str(e))
        }
    }
}

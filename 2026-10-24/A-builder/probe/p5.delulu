module probe.p5

fn main(root: Root) ! {Write} {
    let c = root.console()
    c.println("p+ " + str(parse_int("+5")))
    c.println("p sp " + str(parse_int(" 5")))
    c.println("p -0 " + str(parse_int("-0")))
    c.println("p max " + str(parse_int("9223372036854775807")))
    c.println("p over " + str(parse_int("9223372036854775808")))
    c.println("p min " + str(parse_int("-9223372036854775808")))
    c.println("p arab " + str(parse_int("٣")))
    c.println("p hex " + str(parse_int("0x10")))
    c.println("p us " + str(parse_int("1_000")))
    c.println("p empty " + str(parse_int("")))
    c.println("p dot " + str(parse_int("1.5")))
    c.println("p lead0 " + str(parse_int("007")))
    c.println("f1 " + str(1.0))
    c.println("f2 " + str(0.1 + 0.2))
    c.println("f3 " + str(1.0 / 0.0))
    c.println("f4 " + str(0.0 / 0.0))
    c.println("f5 " + str(0.0 - 0.0))
    c.println("f6 " + str(1.0e21))
    c.println("f7 " + str(1.0e-7))
    c.println("f8 " + str(123456789.125))
    c.println("f9 " + str(2.5e300 * 1.0e10))
    c.println("i2f " + str(float(7) / 2.0))
    c.println("f2i " + str(int(3.99)))
    c.println("f2i neg " + str(int(0.0 - 3.99)))
    c.println("f2i nan " + str(int(0.0 / 0.0)))
    c.println("f2i big " + str(int(1.0e30)))
    c.println("min " + str(0 - 9223372036854775807 - 1))
    c.println("neg " + str(-5))
    c.println("cmpf " + str(0.0 / 0.0 == 0.0 / 0.0) + " " + str(0.0 == (0.0 - 0.0)))
    c.println("str= " + str("a" == "a") + str("é" == "e\u{301}"))
    c.println("sl " + "hello".slice(3, 99) + "|" + "hello".slice(4, 2) + "|" + "hello".slice(0 - 2, 3) + "|")
}

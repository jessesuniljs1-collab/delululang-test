module ratlib

pub type Rat {
    num: Int,
    den: Int,
}

pub type RatErr = ZeroDen | DivByZero

pub fn abs_i(x: Int) -> Int {
    if x < 0 { 0 - x } else { x }
}

pub fn gcd(a: Int, b: Int) -> Int {
    var x = abs_i(a)
    var y = abs_i(b)
    while y != 0 {
        let t = x % y
        x = y
        y = t
    }
    x
}

pub fn make(n: Int, d: Int) -> Result[Rat, RatErr] {
    if d == 0 {
        Err(ZeroDen)
    } else {
        let g = gcd(n, d)
        let s = if d < 0 { 0 - 1 } else { 1 }
        Ok(Rat { num: s * (n / g), den: s * (d / g) })
    }
}

pub fn of_int(n: Int) -> Rat {
    Rat { num: n, den: 1 }
}

fn norm(n: Int, d: Int) -> Rat {
    let g = gcd(n, d)
    let s = if d < 0 { 0 - 1 } else { 1 }
    Rat { num: s * (n / g), den: s * (d / g) }
}

pub fn rat_add(a: Rat, b: Rat) -> Rat {
    let g = gcd(a.den, b.den)
    let l = a.den / g * b.den
    norm(a.num * (l / a.den) + b.num * (l / b.den), l)
}

pub fn rat_sub(a: Rat, b: Rat) -> Rat {
    rat_add(a, Rat { num: 0 - b.num, den: b.den })
}

pub fn rat_mul(a: Rat, b: Rat) -> Rat {
    let g1 = gcd(a.num, b.den)
    let g2 = gcd(b.num, a.den)
    let n1 = if g1 == 0 { 0 } else { a.num / g1 }
    let d2 = if g1 == 0 { b.den } else { b.den / g1 }
    let n2 = if g2 == 0 { 0 } else { b.num / g2 }
    let d1 = if g2 == 0 { a.den } else { a.den / g2 }
    norm(n1 * n2, d1 * d2)
}

pub fn rat_div(a: Rat, b: Rat) -> Result[Rat, RatErr] {
    if b.num == 0 { Err(DivByZero) } else { Ok(rat_mul(a, Rat { num: b.den, den: b.num })) }
}

pub fn rat_cmp(a: Rat, b: Rat) -> Int {
    let l = a.num * b.den
    let r = b.num * a.den
    if l < r { 0 - 1 } else { if l > r { 1 } else { 0 } }
}

pub fn rat_pow(a: Rat, k: Int) -> Rat {
    var acc = of_int(1)
    var i = 0
    while i < k {
        acc = rat_mul(acc, a)
        i = i + 1
    }
    acc
}

pub fn rat_text(a: Rat) -> Str {
    if a.den == 1 { str(a.num) } else { str(a.num) + "/" + str(a.den) }
}

pub fn harmonic(n: Int) -> Rat {
    var acc = of_int(0)
    var k = 1
    while k <= n {
        acc = rat_add(acc, Rat { num: 1, den: k })
        k = k + 1
    }
    acc
}

test "gcd basics" {
    assert_eq(gcd(12, 18), 6)
    assert_eq(gcd(0, 5), 5)
    assert_eq(gcd(0 - 12, 18), 6)
    assert_eq(gcd(7, 0), 7)
}

test "make normalizes sign and reduces" {
    match make(6, 0 - 8) {
        Ok(r) => {
            assert_eq(r.num, 0 - 3)
            assert_eq(r.den, 4)
        }
        Err(e) => assert(false)
    }
    match make(1, 0) {
        Ok(r) => assert(false)
        Err(e) => assert(e == ZeroDen)
    }
}

test "arithmetic" {
    let half = of_int(1)
    let third = Rat { num: 1, den: 3 }
    let s = rat_add(Rat { num: 1, den: 2 }, third)
    assert_eq(rat_text(s), "5/6")
    assert_eq(rat_text(rat_sub(third, Rat { num: 1, den: 2 })), "-1/6")
    assert_eq(rat_text(rat_mul(Rat { num: 2, den: 3 }, Rat { num: 3, den: 4 })), "1/2")
    assert_eq(rat_text(harmonic(10)), "7381/2520")
    assert_eq(rat_cmp(third, half), 0 - 1)
}
